{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery-forge.dev/schemas/checkpoint/1.0.0",
  "title": "Delivery Forge checkpoint",
  "x-contract-kind": "checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "identity", "runId", "sequence", "workflowState", "headCommit", "treeId", "nextAction", "gateReceiptIds", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "checkpoint" },
    "identity": { "$ref": "#/$defs/identity" },
    "runId": { "$ref": "#/$defs/nonEmpty" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "workflowState": { "$ref": "#/$defs/workflowState" },
    "headCommit": { "$ref": "#/$defs/gitObject" },
    "treeId": { "$ref": "#/$defs/gitObject" },
    "nextAction": { "$ref": "#/$defs/nonEmpty" },
    "gateReceiptIds": { "$ref": "#/$defs/identityArray" },
    "createdAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identityArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,7})?Z$" },
    "workflowState": { "enum": ["UNDERSTANDING", "PLANNED", "READY", "EXECUTING", "PAUSED", "LOCAL_COMPLETE", "EVALUATING", "INDEPENDENT_REVIEW", "PR_AUTHORIZED", "PR_PUBLISHED", "CI_COMPLETE", "HOST_REVIEW_COMPLETE", "MERGE_AUTHORIZED", "MERGED", "BLOCKED", "FAILED", "STOPPED"] }
  }
}
